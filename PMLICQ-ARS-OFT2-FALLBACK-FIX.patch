+ rv.type = 0;
+ rv.cookie = f->cookie;
+ memcpy(rv.capability.data(), cap.data(), 16);
+ rv.externalIp = ip;
+ rv.internalIp = ip;
+ rv.port = f->listener.port();
+ rv.requestNumber = 1;
+ rv.hasOffer = true;
+ rv.offer.kind = 1;
+ rv.offer.count = 1;
