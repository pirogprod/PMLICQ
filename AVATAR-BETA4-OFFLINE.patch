+ const auto online=info("33312",{zero,tlv(6,Bytes(4,'\0')),tlv(0x1d,raw2)});
+ const auto aim=info("AIM Buddy",{zero,tlv(0x1d,raw2)});
+ std::vector<Bytes> blocks; assert(splitBuddyUserInfo(off+online+aim,blocks)); assert((blocks==std::vector<Bytes>{off,online,aim}));
