+// 02/06 may also include TLV 0x001D.  Do not alter status/X-status here.
+void CKicqProto::HandleBartUserInfoUpdate(const bytes_t &body)
+{
+ // userinfo = byte SN length + SN + word warning + word TLV count + TLVs
+ if (body.size() < 5) return;
+ const size_t nameLen = uint8_t(body[0]);
+ const size_t head = 1 + nameLen;
