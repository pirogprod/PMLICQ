+// TLV 0x0019 stores the short form of the common OSCAR 0946xxxx GUID
+// family. Expand only the documented 0x13xx family for passive client
+// recognition. No status GUID, wire packet or contact metadata is changed.
+// Returns concatenated 16-byte capabilities; malformed trailing bytes are ignored.
+static std::string KicqCatalogMergeCapabilities(const std::string *fullCaps,
+                                                 const std::string *shortCaps)
+{
+ std::string out;
+ if (fullCaps) {
+  const size_t fullLen = (fullCaps->size() / 16) * 16;
+  out.assign(fullCaps->data(), fullLen);
+ }
+ if (shortCaps) {
+  static const unsigned char suffix[12] = {
+   0x4c,0x7f,0x11,0xd1,0x82,0x22,0x44,0x45,0x53,0x54,0x00,0x00
+  };
+  for (size_t i=0; i+1<shortCaps->size(); i+=2) {
+   const unsigned char hi=(unsigned char)(*shortCaps)[i];
+   const unsigned char lo=(unsigned char)(*shortCaps)[i+1];
+   if (hi != 0x13) continue;
+   unsigned char cap[16] = {0x09,0x46,hi,lo};
+   memcpy(cap+4,suffix,sizeof(suffix));
+   bool already=false;
+   for (size_t p=0; p+16<=out.size(); p+=16)
+    if (memcmp(out.data()+p,cap,16)==0) { already=true; break; }
+   if (!already) out.append((const char*)cap,16);
+  }
+ }
+ return out;
+}
