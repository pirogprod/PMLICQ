   message(STATUS "PMLICQ: unable to determine Miranda NG revision; use the SDK/source matching the exact installed 0.96.7 build")
 endif()
 
+# Default to the modern contact ABI, including the user's #28846 build.
+# Legacy builds must opt in explicitly and use the matching legacy runtime.
+option(PMLICQ_ALLOW_LEGACY_CONTACT_API "Allow old contact ABI (NOT compatible with #28846)" OFF)
+set(PMLICQ_DB_HEADER "${CMAKE_SOURCE_DIR}/include/m_database.h")
+if(NOT EXISTS "${PMLICQ_DB_HEADER}")
+  message(FATAL_ERROR "PMLICQ: Miranda SDK m_database.h not found")
+endif()
+file(STRINGS "${PMLICQ_DB_HEADER}" PMLICQ_DBAC_DECL REGEX "^[ \t]*#[ \t]*define[ \t]+DBAC_NOTINLIST[ \t]+")
+if(PMLICQ_DBAC_DECL)
+  message(STATUS "PMLICQ contact ABI: new (module, flags)")
+elseif(PMLICQ_ALLOW_LEGACY_CONTACT_API)
+  message(WARNING "PMLICQ contact ABI: LEGACY; resulting DLL must NOT be used on #28846")
+else()
+  message(FATAL_ERROR "PMLICQ_CONTACT_ABI_MISMATCH: use Miranda revision 495fea6 for build #28846. Old SDK is not accepted by default.")
+endif()
+
 file(GLOB SOURCES "src/*.h" "src/*.cpp" "res/*.rc")
 set(TARGET KICQ)
 include(${CMAKE_SOURCE_DIR}/cmake/plugin.cmake)
 target_link_libraries(${TARGET} ws2_32.lib)
+if(PMLICQ_ALLOW_LEGACY_CONTACT_API)
+  target_compile_definitions(${TARGET} PRIVATE PMLICQ_ALLOW_LEGACY_CONTACT_API)
+endif()
